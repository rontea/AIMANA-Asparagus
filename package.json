{
  "name": "aimana-project-manager",
  "version": "0.16.99-dev",
  "description": "Local-first Asset Management System with AI integration",
  "main": "index.js",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node index.js",
    "install:app": "node scripts/install.mjs",
    "install:app:headless": "node scripts/install.mjs --headless",
    "upgrade:app": "node scripts/upgrade-app.mjs",
    "rag:index": "node scripts/rag-index.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "node --test server/tests/**/*.test.mjs",
    "test:install-smoke": "node scripts/release-smoke-install.mjs",
    "validate:extensions": "vitest run extensions/loader.test.ts extensions/registry.test.ts extensions/installedValidation.test.ts extensions/security.test.ts packages/example-semantic-forge/src/index.test.ts packages/example-semantic-forge/src/import-boundary.test.ts && node --test server/tests/extension-api.test.mjs server/tests/extension-migrations.test.mjs server/tests/installed-extension-validation.test.mjs"
  },
  "dependencies": {
    "@aimana/extension-sdk": "file:packages/extension-sdk",
    "@aimana/extension-semantic-forge": "file:packages/example-semantic-forge",
    "@google/genai": "latest",
    "archiver": "^8.0.0",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.378.0",
    "multer": "^1.4.5-lts.1",
    "otpauth": "^9.2.2",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.23.1",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^2.3.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.12.12",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
