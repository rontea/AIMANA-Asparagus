exports[`AIChat visual regression states > captures sending state 1`] = `"<div class="chat-runtime flex flex-col -m-4 sm:-m-6 lg:-m-8 bg-slate-900 relative min-h-full overflow-visible"><div class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div><div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_20%_0%,rgba(99,102,241,0.12),transparent_42%),radial-gradient(circle_at_80%_100%,rgba(59,130,246,0.06),transparent_48%)]"></div><div class="relative min-h-16 md:min-h-20 flex items-center justify-between px-3 sm:px-5 md:px-8 py-3 border-b border-slate-800/70 shrink-0 bg-slate-900/20 z-30"><div class="flex min-w-0 items-center gap-3 sm:gap-4 md:gap-6"><button class="chat-focus-ring shrink-0 text-slate-500 hover:text-white transition-colors flex items-center gap-2 text-[10px] md:text-xs font-bold uppercase tracking-widest group rounded-md"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left group-hover:-translate-x-1 transition-transform"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg><span class="hidden sm:inline">Generate Content</span></button><div class="h-5 w-px bg-slate-800 hidden sm:block"></div><div class="flex min-w-0 items-center gap-2 sm:gap-3 md:gap-4"><div class="shrink-0 p-2 rounded-xl chat-token-card-active"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles text-indigo-400"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></p